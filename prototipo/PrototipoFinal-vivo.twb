              <calculation class='tableau' formula='[escenario] = [Parameters].[Parameter 1]' />
            </column>
            <column caption='R label' datatype='string' name='[Calculation_714665033615634440]' role='measure' type='nominal'>
              <calculation class='tableau' formula='&quot;R = &quot; + REPLACE(STR(ROUND(SUM([R_centro_caro]),2)),&quot;.&quot;,&quot;,&quot;) + &quot; vs &quot; + REPLACE(STR(ROUND(SUM([R_resto]),2)),&quot;.&quot;,&quot;,&quot;) + &quot; kg/kg en el resto&quot;' />
            </column>
            <column caption='R centro caro' datatype='real' name='[R_centro_caro]' role='measure' type='quantitative' />
            <column caption='R resto' datatype='real' name='[R_resto]' role='measure' type='quantitative' />
