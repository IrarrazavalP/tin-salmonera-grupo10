            <column-instance column='[Calculation_714665033614970885]' derivation='None' name='[none:Calculation_714665033614970885:nk]' pivot='key' type='nominal' />
            <column caption='Sobrecosto Total Mm Clp' datatype='real' name='[sobrecosto_total_mm_clp]' role='measure' type='quantitative' />
