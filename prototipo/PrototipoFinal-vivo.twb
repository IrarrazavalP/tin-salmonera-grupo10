        </view>
        <style>
          <style-rule element='cell'>
            <format attr='text-format' field='[federated.14d61tn1fget5w10xr72n0glvzt0].[sum:sobrecosto_total_mm_clp:qk]' value='*&quot;CLP &quot;#,##0&quot; MM&quot;' />
