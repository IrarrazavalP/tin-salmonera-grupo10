            <column-instance column='[Calculation_714665033615634440]' derivation='User' name='[usr:Calculation_714665033615634440:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.14d61tn1fget5w10xr72n0glvzt0].[none:Calculation_714665033614970885:nk]'>
            <groupfilter function='member' level='[none:Calculation_714665033614970885:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
